# ==============================================================================
# nia mobility - Environment Configuration Template
# Developed by Denory Codespace
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME="nia mobility"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api/v1"

# Database Configuration (PostgreSQL / Supabase)
# For local dev or testing without a remote database, an in-memory/mock fallback adapter is available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niamobility?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/niamobility?schema=public"

# Supabase Credentials (Optional for local mock mode; Required for Supabase Auth/Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# JWT & Authentication Secret (For standalone auth & session verification)
AUTH_SECRET="nia-mobility-super-secret-dev-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Redis / Upstash (Optional in dev mock mode; Used for rate limiting & job queues)
REDIS_URL="redis://localhost:6379"

# Kenyan Payment Gateway: Safaricom M-PESA Daraja API (Sandbox / Production)
MPESA_ENVIRONMENT="sandbox" # sandbox | production
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_PASSKEY="your_mpesa_passkey"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="http://localhost:3000/api/v1/payments/mpesa/callback"

# Communication & Notifications (Mocked in dev mode)
SMS_PROVIDER="mock" # mock | africastalking | twilio
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"

EMAIL_PROVIDER="mock" # mock | resend | sendgrid
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@niamobility.co.ke"

# Maps & Geolocation
NEXT_PUBLIC_MAPS_PROVIDER="mock" # mock | mapbox | google
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Observability & Analytics (Optional in dev)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
